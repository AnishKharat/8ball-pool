# Port the server listens on. Render sets PORT itself (10000 unless you change it); locally the default is 3000.
PORT=3000

# Comma-separated list of origins allowed to open a game socket, e.g. https://chalkline.onrender.com,https://pool.example.com
# Empty allows any origin, which is fine for local development. On Render, an empty value falls back to
# RENDER_EXTERNAL_URL (the service's onrender.com address), which Render sets automatically.
ALLOWED_ORIGIN=

# Load this file locally with: node --env-file=.env packages/server/dist/index.cjs
